<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1-create-recipes-table" author="developer">
        <createTable tableName="recipes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="vegetarian" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="servings" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1-create-recipe-ingredients-table" author="developer">
        <createTable tableName="recipe_ingredients">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="recipe_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="NUMERIC(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="recipe_ingredients"
                baseColumnNames="recipe_id"
                constraintName="fk_recipe_ingredients_recipe"
                referencedTableName="recipes"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="1-create-recipe-instructions-table" author="developer">
        <createTable tableName="recipe_instructions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="recipe_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="step_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="instruction_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="recipe_instructions"
                baseColumnNames="recipe_id"
                constraintName="fk_recipe_instructions_recipe"
                referencedTableName="recipes"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
